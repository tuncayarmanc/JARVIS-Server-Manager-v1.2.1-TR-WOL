{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capabilities for J.A.R.V.I.S Server Manager",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ssh",
          "cmd": "ssh",
          "args": [
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=8",
            "-o",
            "ServerAliveInterval=15",
            "-o",
            "ServerAliveCountMax=2",
            "-p",
            {
              "validator": "[1-9][0-9]{0,4}"
            },
            "-i",
            {
              "validator": ".+"
            },
            {
              "validator": "[A-Za-z0-9._-]+@[A-Za-z0-9._:-]+"
            },
            {
              "validator": ".+"
            }
          ]
        }
      ]
    },
    "dialog:default"
  ]
}
